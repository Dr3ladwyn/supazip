(( $+functions[_supazip__subcmd__list_commands] )) ||
_supazip__subcmd__list_commands() {
    local commands; commands=()
    _describe -t commands 'supazip list commands' commands "$@"
}
(( $+functions[_supazip__subcmd__man_commands] )) ||
_supazip__subcmd__man_commands() {
    local commands; commands=()
    _describe -t commands 'supazip man commands' commands "$@"
