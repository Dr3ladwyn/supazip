# Build artifacts
/target/
**/target/

# Cargo.lock: tracked for binary crates / workspaces; ignored for libraries.
# SupaZip ships binaries (supazip-gui, supazip-cli), so Cargo.lock is committed.

# Editor / IDE
.idea/
.vscode/
*.iml
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Local environment files (never commit secrets)
.env
.env.*
!.env.example

# Logs
*.log

# rust-analyzer
rust-project.json

# Vendored PeaZip reference: a nested git checkout for design inspiration
# only. It is not part of the SupaZip build. Do not `git add` this tree
# (including as a gitlink / submodule) unless a real `.gitmodules` entry
# is added on purpose.
/PeaZip/

# Cursor local artifacts (agent scratchpads, hooks, etc.) — not source.
.claude/

# proptest writes a *.proptest-regressions file next to a test that
# failed but the user did not pin (or failed outside a regression test).
# These files are scratch state, not source. See
# https://altsysrq.github.io/proptest-book/proptest/file-persistence.html
*.proptest-regressions

